# PostgreSQL
POSTGRES_PASSWORD=msh_secret
# Host port 5433-ra van mappelve a docker-compose-ban
DATABASE_URL=postgresql://msh:msh_secret@localhost:5433/msh

# RabbitMQ
RABBITMQ_USER=msh
RABBITMQ_PASSWORD=msh_secret
RABBITMQ_URL=amqp://msh:msh_secret@localhost:5672

# MinIO
MINIO_ROOT_USER=msh
MINIO_ROOT_PASSWORD=msh_secret
# Docker-en belül a backend "minio"-n éri el, a presigned URL-ek "localhost"-on
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
# App-kliensek (backend/worker) MinIO eléréshez
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=msh
MINIO_SECRET_KEY=msh_secret
MINIO_BUCKET=msh-models
MINIO_USE_SSL=false

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# SMTP — Gmail (email verification)
# SMTP_USER: a Gmail címed (pl. valami@gmail.com)
# SMTP_PASS: Gmail App Password
# MAIL_FROM: általában ugyanaz, mint SMTP_USER
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Backend URL (frontend használja)
API_URL=http://localhost:3000

# Service portok
PORT=3000
WORKER_PORT=3001
